import java.util.Scanner;

public class Task26 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Duita number den: ");
        int a = sc.nextInt(), b = sc.nextInt();

        // Euclidean algorithm use kore GCD ber kora hocche
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        System.out.println("GCD holo: " + a);
    }
}
