import java.util.Scanner;

public class Task6 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Ekta number den: ");
        int num = sc.nextInt();

        // 2 diye vag korle vagshesh 0 hole Even, noile Odd
        if (num % 2 == 0) {
            System.out.println(num + " ekta Even (Jor) number.");
        } else {
            System.out.println(num + " ekta Odd (Bijor) number.");
        }
    }
}
