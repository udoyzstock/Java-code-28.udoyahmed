import java.util.Scanner;

public class Task13 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Row songkha den: ");
        int rows = sc.nextInt();

        // Outer loop row control korbe, inner loop star print korbe
        for (int i = 1; i <= rows; i++) {
            for (int j = 1; j <= i; j++) {
                System.out.print("* ");
            }
            System.out.println(); // Notun line e jawar jonno
        }
    }
}
