import java.util.Scanner;

public class Task11 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Ekta number den: ");
        int num = sc.nextInt();
        long fact = 1;

        // 1 theke num porjonto sob gun kora hocche
        for (int i = 1; i <= num; i++) {
            fact *= i;
        }
        System.out.println(num + " er Factorial holo: " + fact);
    }
}
