import java.util.Scanner;

public class ArmstrongNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number: ");
        int num = sc.nextInt();
        
        int originalNum = num;
        int sum = 0;
        int digits = String.valueOf(num).length(); // Number-e koyta digit ache ta ber kora

        while (num > 0) {
            int digit = num % 10; // Last digit ber kora
            sum += Math.pow(digit, digits); // Digit-er power jog kora
            num /= 10; // Last digit bad dewa
        }

        // Original number ar sum soman kina check kora
        if (sum == originalNum) {
            System.out.println(originalNum + " is an Armstrong number.");
        } else {
            System.out.println(originalNum + " is not an Armstrong number.");
        }
    }
}
