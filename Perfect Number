import java.util.Scanner;

public class Task9 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Ekta number den: ");
        int num = sc.nextInt();
        int sum = 0;

        // Number tar nijeke bad diye baki vajoq (divisors) gulor jogfol
        for (int i = 1; i <= num / 2; i++) {
            if (num % i == 0) {
                sum += i;
            }
        }

        if (sum == num && num > 0) {
            System.out.println(num + " ekta Perfect number.");
        } else {
            System.out.println(num + " Perfect number na.");
        }
    }
}
