public class Task23 {
    // Eta Instance variable (class er vitor kintu method er baire)
    int instanceVar = 50;

    void showVariables() {
        // Eta Local variable (shudhu ei method er vitorei kaj korbe)
        int localVar = 20;
        System.out.println("Instance Variable: " + instanceVar);
        System.out.println("Local Variable: " + localVar);
    }

    public static void main(String[] args) {
        Task23 obj = new Task23();
        obj.showVariables();
    }
}
