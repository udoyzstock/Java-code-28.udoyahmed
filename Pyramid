import java.util.Scanner;

public class Task14 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Row songkha den: ");
        int rows = sc.nextInt();

        for (int i = 1; i <= rows; i++) {
            // Prothome space print korar loop
            for (int j = i; j < rows; j++) {
                System.out.print(" ");
            }
            // Tarpor star print korar loop
            for (int k = 1; k <= (2 * i - 1); k++) {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
