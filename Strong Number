import java.util.Scanner;

public class Task5 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Ekta number den: ");
        int num = sc.nextInt();
        int original = num, sum = 0;

        while (num > 0) {
            int rem = num % 10;
            // Prottek digit er factorial ber korar loop
            int fact = 1;
            for (int i = 1; i <= rem; i++) {
                fact *= i;
            }
            sum += fact; // Factorial gulo jog korchi
            num /= 10;
        }

        if (sum == original) {
            System.out.println(original + " ekta Strong number.");
        } else {
            System.out.println(original + " Strong number na.");
        }
    }
}
